# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host + scheme -------------------------------------------
  # Force https://ntacpa.com (no www, no http). Matches `site` in
  # astro.config.mjs, and every canonical/og:url tag the build emits.
  # One rule handles both cases in a single redirect, so a request that's
  # wrong on both counts (http://www...) only round-trips once.
  RewriteCond %{HTTP_HOST} !^ntacpa\.com$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://ntacpa.com%{REQUEST_URI} [L,R=301]

  # --- Legacy URL redirects (see URL-AUDIT.md) ----------------------------
  # The old site's "Credentials" section (education/experience/training) and
  # the retired client list all fold into the new About page. The unlinked
  # contact_form.html goes to Contact, not About, since that's what it was.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^education\.html$ /about [R=301,L]
  RewriteRule ^experience\.html$ /about [R=301,L]
  RewriteRule ^training\.html$ /about [R=301,L]
  RewriteRule ^clients\.html$ /about [R=301,L]
  RewriteRule ^contact_form\.html$ /contact [R=301,L]

  # --- Serve extensionless paths from their .html file --------------------
  # Internal links are written as /services, /about, etc. (see
  # src/utils/url.ts), but the build emits /services.html on disk. Netlify/
  # Vercel/Cloudflare strip .html automatically; Apache doesn't, so without
  # this every internal link on the site 404s. Internal rewrite only — the
  # browser's address bar keeps showing the clean URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
