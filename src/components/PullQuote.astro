---
/**
 * A quote bound to its supporting copy by a vertical gold rule. The vertical
 * bind is one of only two sanctioned uses of the gold rule — see
 * _design-system/readme.md, "The gold rule".
 */
interface Props {
  quote: string;
  /** Measure class for the quote line. */
  quoteMeasure?: string;
}

const { quote, quoteMeasure = 'measure-34' } = Astro.props;
---

<figure class="pullquote">
  <span class="pullquote__rule" aria-hidden="true"></span>
  <div>
    <blockquote class:list={['pullquote__quote', quoteMeasure]}>{quote}</blockquote>
    <figcaption class="pullquote__body">
      <slot />
    </figcaption>
  </div>
</figure>

<style>
  .pullquote {
    margin: 0;
  }

  .pullquote__quote {
    margin: 0 0 24px;
  }

  .pullquote__body :global(p) {
    font-size: var(--type-body);
    line-height: var(--leading-relaxed);
    color: var(--text-body);
  }

  .pullquote__body :global(p + p) {
    margin-top: 16px;
  }
</style>
