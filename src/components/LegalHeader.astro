---
/**
 * Stripped chrome for the two legal pages: compact lockup, back link.
 * No nav, no CTA, not sticky — deliberately quieter than the site header.
 *
 * The logo renders from the locked brand-asset SVGs (public/assets/),
 * matching the site header's treatment: compact lockup at every width — see
 * "NTA Site Header.dc.html" and MANIFEST.md. This is still a header band
 * (~56px logo), and `logo-primary.svg` needs a 320px minimum width before
 * its descriptor is legible, which no header band can offer. The asset
 * package's lockup SVGs carry outlined text (no font-family dependency),
 * so they're safe as an <img src> — see _design-system/brand-assets/MANIFEST.md.
 */
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<header class="legal-header">
  <div class="container legal-header__inner">
    <a href={withBase('/')} class="legal-header__logo" aria-label={`${site.name} — home`}>
      <img
        src={withBase('/assets/logo-compact.svg')}
        alt=""
        width="374"
        height="120"
        class="legal-header__logo-mark"
      />
    </a>
    <a href={withBase('/')} class="legal-header__back">← Back to site</a>
  </div>
</header>

<style>
  .legal-header {
    background: var(--surface-page);
    border-bottom: var(--rule-hairline) solid var(--nta-line);
  }

  .legal-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-block: 20px;
  }

  .legal-header__back {
    font-size: var(--type-small);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .legal-header__logo-mark {
    height: 56px;
    width: auto;
  }

  @media (max-width: 620px) {
    .legal-header__logo-mark {
      height: 44px;
      width: auto;
    }
    .legal-header__inner {
      padding-block: 16px;
    }
  }
</style>
