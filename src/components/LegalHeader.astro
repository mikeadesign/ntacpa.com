---
/**
 * Stripped chrome for the two legal pages: compact lockup, back link.
 * No nav, no CTA, not sticky — deliberately quieter than the site header.
 *
 * The logo renders from the locked brand-asset PNG (public/assets/), matching
 * the site header's compact treatment — PNG, not SVG, because an
 * <img src="*.svg"> can't see the page's loaded Spectral webfont and falls
 * back to a wider system serif that clips against the SVG's fixed viewBox.
 * See _design-system/brand-assets/MANIFEST.md.
 */
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<header class="legal-header">
  <div class="container legal-header__inner">
    <a href={withBase('/')} class="legal-header__logo" aria-label={`${site.name} — home`}>
      <img
        src={withBase('/assets/logo-compact.png')}
        alt=""
        width="178"
        height="56"
        class="legal-header__logo-mark"
      />
    </a>
    <a href={withBase('/')} class="legal-header__back">← Back to site</a>
  </div>
</header>

<style>
  .legal-header {
    background: var(--surface-page);
    border-bottom: var(--rule-hairline) solid var(--nta-line);
  }

  .legal-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-block: 20px;
  }

  .legal-header__back {
    font-size: var(--type-small);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .legal-header__logo-mark {
      width: 127px;
      height: 40px;
    }
    .legal-header__inner {
      padding-block: 16px;
    }
  }
</style>
