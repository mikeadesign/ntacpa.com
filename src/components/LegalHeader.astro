---
/**
 * Stripped chrome for the two legal pages: full lockup, back link.
 * No nav, no CTA, not sticky — deliberately quieter than the site header.
 *
 * The logo renders from the locked brand-asset SVGs (public/assets/),
 * matching the site header's treatment: full lockup by default, swapping to
 * "compact" below 620px via <picture>, since there's no inline nav here to
 * key the breakpoint off of. The asset package's lockup SVGs carry outlined
 * text (no font-family dependency), so they're safe as an <img src> — see
 * _design-system/brand-assets/MANIFEST.md.
 */
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<header class="legal-header">
  <div class="container legal-header__inner">
    <a href={withBase('/')} class="legal-header__logo" aria-label={`${site.name} — home`}>
      <picture>
        <source media="(max-width: 620px)" srcset={withBase('/assets/logo-compact.svg')} />
        <img
          src={withBase('/assets/logo-primary.svg')}
          alt=""
          width="400"
          height="120"
          class="legal-header__logo-mark"
        />
      </picture>
    </a>
    <a href={withBase('/')} class="legal-header__back">← Back to site</a>
  </div>
</header>

<style>
  .legal-header {
    background: var(--surface-page);
    border-bottom: var(--rule-hairline) solid var(--nta-line);
  }

  .legal-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding-block: 20px;
  }

  .legal-header__back {
    font-size: var(--type-small);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .legal-header__logo-mark {
    width: 187px;
    height: auto;
  }

  @media (max-width: 620px) {
    .legal-header__logo-mark {
      width: 125px;
      height: auto;
    }
    .legal-header__inner {
      padding-block: 16px;
    }
  }
</style>
